# このファイルを .env にコピーして使う（scripts/up.sh は .env が無ければ自動でコピーする）

# 起動直後に選ばれるモデル。未ダウンロードなら起動時に自動でダウンロードする
DEFAULT_MODEL=gemma4:e4b

# Ollama コンテナのメモリ上限（超えたら Ollama の中だけが強制終了し、自動で再起動する）
OLLAMA_MEM_LIMIT=24g

# 応答が来ないまま、この秒数がたったら打ち切る（文字が届くたびに数え直す）
IDLE_TIMEOUT_SEC=180

# コンテキスト長の上限（トークン数）と、警告を出す割合
NUM_CTX=8192
CONTEXT_WARN_RATIO=0.8

# 負荷区分のしきい値（GB）。COMFORT 以下は「快適」、EXCLUDE 以上は一覧に出さない
TIER_COMFORT_MAX_GB=7
TIER_EXCLUDE_MIN_GB=20

# 起動時のモデル自動検索（models.yaml の families）。結果を保存しておく時間
DISCOVERY_TTL_HOURS=24
DISCOVERY_ENABLED=true

# 保存するセッションの数
SESSION_LIMIT=10

# 画面の公開先（ホスト側）。127.0.0.1 はこの PC からのみ
BIND_ADDRESS=127.0.0.1
PORT=3000
